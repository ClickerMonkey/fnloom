# Generated by scripts/env-example.ts from the settings schemas. Do not edit; run `npm run env:example`.
# Copy to .env (git-ignored) and fill in. `npm run dev` and the hub read it; values already in the environment win.
# Durations are milliseconds.

HARNESS_PORT=4300

# The address the hub binds to.
HARNESS_HOST=0.0.0.0

# The data folder: database, files, installed systems, logs.
HARNESS_DATA=.harness

# The public URL, for pairing links and push. Defaults to this machine on `HARNESS_PORT`.
HARNESS_URL=http://localhost:4300

# The SQLite database file.
HARNESS_DB_FILE=.harness/hub.sqlite

# Where uploaded and stored files are kept.
HARNESS_FILES_DIR=.harness/files

# Where installed systems are unpacked.
HARNESS_SYSTEMS_DIR=.harness/systems

# Where daily log files are written.
HARNESS_LOG_DIR=.harness/logs

# The secrets the hub makes for itself when they aren't given (JWT, encryption, files, VAPID keys).
HARNESS_KEYS_FILE=.harness/keys.json

# The built web app the hub serves (`npm run build`). Empty: `packages/web/dist` beside the hub package.
HARNESS_WEB_DIST=

# Serve the API docs (`/docs/swagger`, `/docs/redoc`, `/docs/asyncapi`).
HARNESS_DOCS=false

# The largest upload, in bytes.
HARNESS_MAX_UPLOAD=104857600

# How long a presigned upload or download URL stays valid.
HARNESS_PRESIGN_TTL=600000

# The WebSocket ping interval; a connection that misses a pong is dropped.
HARNESS_WS_HEARTBEAT=30000

# A browser socket is closed this long before its access token expires, so it reconnects with a fresh one.
HARNESS_WS_TOKEN_MARGIN=10000

# Event-loop delay (running average) that counts as overloaded.
HARNESS_SHED_THRESHOLD=200

# How long the loop must stay overloaded before requests are refused.
HARNESS_SHED_SUSTAINED=1000

# How long it must stay healthy before requests are accepted again.
HARNESS_SHED_RECOVER=2000

# How long the hub waits for everything to stop on shutdown.
HARNESS_SHUTDOWN_TIMEOUT=30000

# Signs access and refresh tokens (at least 32 characters). Made and stored when not given.
# HARNESS_JWT_SECRET=

# Encrypts stored secrets such as provider keys (at least 32 characters). Made and stored when not given.
# HARNESS_SECRET_KEY=

# The single admin account's email. Made on the first start.
# HARNESS_ADMIN_EMAIL=

# The single admin account's password (at least 10 characters).
# HARNESS_ADMIN_PASSWORD=

# How long an access token lasts.
HARNESS_ACCESS_TTL=900000

# How long a refresh token lasts.
HARNESS_REFRESH_TTL=2592000000

# Most sign-in attempts from one address in a window.
HARNESS_SIGN_IN_LIMIT=10

# The window sign-in attempts are counted over.
HARNESS_SIGN_IN_WINDOW=60000

# scrypt's cost as a power of two (15: 32 768 rounds).
HARNESS_PASSWORD_COST=15

# Signs presigned file URLs.
# HARNESS_FILES_SECRET=

# How many LLM calls run at once.
HARNESS_LLM_CONCURRENCY=4

# Per system.
HARNESS_RUN_CONCURRENCY=8

# A tool running longer than this stops blocking the agent, if a user is active in the session.
HARNESS_TOOL_TIMEOUT=30000

# How recently a user must have been active to count as present.
HARNESS_ACTIVE_WINDOW=120000

# The priority of work no rule gives one.
HARNESS_DEFAULT_PRIORITY=interactive

# The most one turn may spend, in dollars, unless a budget says otherwise.
HARNESS_TURN_COST=0.5

# The longest one turn may run, unless a budget says otherwise.
HARNESS_TURN_TIME=600000

# Reserve this much more than the estimate before an LLM call.
HARNESS_BUDGET_MARGIN=1.25

# The largest frame a system link accepts, in bytes.
HARNESS_MAX_FRAME=262144

# The largest chunk a stream is cut into on a system link, in bytes.
HARNESS_MAX_CHUNK=131072

# How often a system link is pinged; a link that misses a pong is dropped.
HARNESS_HEARTBEAT=15000

# How long a pairing request waits for an admin.
HARNESS_PAIRING_TIMEOUT=600000

# How long an installed system has to stop before it is killed.
HARNESS_STOP_TIMEOUT=10000

# The first delay before an installed system that exited is started again.
HARNESS_RESTART_BACKOFF=2000

# Most restarts of one installed system in an hour before it is left stopped.
HARNESS_RESTARTS_PER_HOUR=10

# An OpenRouter key; configures the openrouter provider on first start.
# OPENROUTER_API_KEY=

# The model voice input is transcribed with: a model with hearing from a configured provider (for example whisper-1 on OpenAI). Empty turns voice input off.
HARNESS_TRANSCRIBE_MODEL=

# The model the chat agent uses until an admin picks one.
HARNESS_DEFAULT_MODEL=openrouter/auto

# The embedder that embeds indexed text (documents): a qualified embedder name from a system.
HARNESS_EMBEDDER_DOCUMENT=embedder/document

# The embedder that embeds search text (queries), in the same vector space as the document embedder.
HARNESS_EMBEDDER_QUERY=embedder/query

# Most texts in one embed batch.
HARNESS_EMBED_BATCH=32

# How many fns and context the composer suggests.
HARNESS_SUGGESTIONS=6

# The lowest level that is logged.
HARNESS_LOG_LEVEL=info

# Log JSON lines instead of readable text.
HARNESS_LOG_JSON=false

# Also write logs to daily files in the log folder.
HARNESS_LOG_FILES=true

# How many daily log files to keep.
HARNESS_LOG_KEEP=7

# The web push public key. Made and stored when not given.
# HARNESS_VAPID_PUBLIC=

# The web push private key. Made and stored when not given.
# HARNESS_VAPID_PRIVATE=

# The contact web push services are given.
HARNESS_VAPID_SUBJECT=mailto:admin@localhost

# How long a write waits for another process's write lock before failing.
HARNESS_DB_BUSY_TIMEOUT=5000

# Hybrid search: the reciprocal-rank constant (higher flattens the gap between ranks).
HARNESS_SEARCH_RRF_K=60

# Hybrid search: each index is asked for `limit × depth` candidates before they are merged.
HARNESS_SEARCH_DEPTH=4

# Expired key/value rows are swept every this many writes.
HARNESS_KV_SWEEP_EVERY=1000

# Most LLM calls that may start in one window, across every model.
HARNESS_LLM_RATE_LIMIT=600

# Most LLM calls that may start in one window on any one model.
HARNESS_MODEL_RATE_LIMIT=120

# The window both LLM rate limits count over.
HARNESS_LLM_RATE_WINDOW=60000

# How far past a budget a call may go (a fraction of the budget), so an estimate a little low never blocks.
HARNESS_BUDGET_OVERRUN=0.05

# How long a call waits before checking again when a budget whose rule says `wait` is full.
HARNESS_BUDGET_RECHECK=60000

# The first delay before a failed run classed `retry` runs again (doubled on each retry).
HARNESS_RUN_RETRY_BASE=1000

# How often the queues look for due work when idle.
HARNESS_QUEUE_POLL=250

# Consecutive iterations whose tool calls all fail before an agent run stops.
HARNESS_AGENT_TOOL_FAILURES=4

# How long a system has to write a mention's LLM text when a message is sent.
HARNESS_MENTION_TIMEOUT=5000

# How long a system has to answer `@` search and hover.
HARNESS_MENTION_SEARCH_TIMEOUT=3000

# How long a system has to answer one delivered action or form.
HARNESS_DELIVERY_TIMEOUT=30000

# Messages per page when a request gives no limit.
HARNESS_MESSAGE_PAGE=50

# Sessions per page when a request gives no limit.
HARNESS_SESSION_PAGE=30

# A session titled by its first message keeps this many characters of it.
HARNESS_TITLE_LENGTH=60

# A turn stops after this many failed runs; 0 keeps feeding errors back to the agent.
HARNESS_TURN_ERRORS=3

# The most runs one turn's undo looks at.
HARNESS_UNDO_RUNS=500

# How long an embed batch waits for more texts after its first before it is sent.
HARNESS_EMBED_WAIT=15

# How often the embed queues look for new texts.
HARNESS_EMBED_POLL=10

# How many embed batches for people and agents waiting now (search, suggestions) run at once.
HARNESS_EMBED_INTERACTIVE=2

# How many embed batches for indexing and systems run at once; the rest wait, so the embedder stays free for people.
HARNESS_EMBED_BACKGROUND=1

# The most characters of a section, fn or context that are embedded.
HARNESS_INDEX_MAX_TEXT=4000

# How many extra candidates search asks for when it filters by system.
HARNESS_SEARCH_OVERFETCH=3

# The longest search waits for its query's embedding (a busy embedder may be indexing) before it searches by words alone.
HARNESS_SEARCH_EMBED_WAIT=4000

# How long after a failed embedding the index first tries again; the wait doubles after each failure.
HARNESS_INDEX_RETRY=5000

# The longest the index waits before trying a failed embedding again.
HARNESS_INDEX_RETRY_MOST=300000

# The most resources one crawl of a root (on connect, for roots that index everything) looks at.
HARNESS_INDEX_CRAWL_MAX=20000

# The context window assumed for a model nothing else describes (logged once per model as `model.limits.guessed`).
HARNESS_DEFAULT_CONTEXT_WINDOW=4096

# The reply length assumed for a model nothing else describes.
HARNESS_DEFAULT_MAX_OUTPUT=1024

# The most window assumed for an Ollama model when neither its Modelfile (num_ctx) nor its provider record sets one; Ollama's own default for its version (2048 before 0.6, else 4096) wins when smaller. Never its trained length.
HARNESS_OLLAMA_DEFAULT_CTX=4096

# How long a provider probe of a model's served limits is kept.
HARNESS_MODEL_PROBE_TTL=600000

# Context and fns the graph contextor retrieves per message before scoring (messages get half).
HARNESS_GRAPH_POOL=48

# Turns an item the agent or person loaded stays forced into the prompt after its last use.
HARNESS_LOADED_TURNS=3

# The most tokens one earlier exchange's summary takes in the system prompt.
HARNESS_EARLIER_TOKENS=120

# A learned link's use count halves after this long without use.
HARNESS_LINK_HALF_LIFE=2592000000

# How long the text a system wrote for a dynamic context item (`fs/tree`, `/new-system`) is kept per session and person before it is asked again.
HARNESS_DYNAMIC_CONTEXT_TTL=300000

# How long the hub waits for a system to write a dynamic context item.
HARNESS_DYNAMIC_CONTEXT_TIMEOUT=15000

# The most dynamic context texts kept in memory (the oldest go first).
HARNESS_DYNAMIC_CONTEXT_CACHE=500

# The share of a model's window kept free for estimate error (at least 64 tokens).
HARNESS_PROMPT_MARGIN=0.06

# Where raw content and forms are kept: files under the data folder, or the hub's database.
HARNESS_CONTENT_AT=files

# The largest raw content the hub accepts, in bytes.
HARNESS_IMPORT_MAX=209715200

# Bytes of system resources' raw snapshots kept before the oldest are dropped (their forms are kept).
HARNESS_SNAPSHOT_MAX=2147483648

# Rows kept per table in a `table` form; the real count is kept beside it.
HARNESS_TABLE_ROWS=5000

# Describe and read text in images while indexing (else only when someone reads them).
HARNESS_DESCRIBE_ON_INDEX=false

# Forms made at once.
HARNESS_FORM_CONCURRENCY=2

# A section longer than this becomes a chain of context pieces (small-model friendly).
HARNESS_CONTEXT_PIECE_TOKENS=600

# How long a URL import waits when the web system isn't connected and the hub fetches itself.
HARNESS_FETCH_TIMEOUT=30000

# The most redirects a URL import the hub fetches itself follows.
HARNESS_FETCH_REDIRECTS=8

# Allow importing private and loopback addresses (off: the hub's own data can't be fetched by asking).
HARNESS_FETCH_PRIVATE=false

# The largest request body a hub MCP accepts, in bytes.
HARNESS_HUB_MCP_MAX_BODY=1048576

# How long an MCP call waits for a person's approval before it ends as not approved.
HARNESS_HUB_MCP_ASK_TIMEOUT=600000

# How long one MCP call may take in all.
HARNESS_HUB_MCP_RUN_TIMEOUT=1800000

# How long a minted MCP session token lasts.
HARNESS_HUB_MCP_TOKEN_TTL=3600000

# How long an MCP session may go with no request and no open event stream before it ends (a client that went away without saying so).
HARNESS_HUB_MCP_IDLE_TIMEOUT=1800000

# Most calls one MCP may start per minute.
HARNESS_HUB_MCP_RATE=120

# The hub as a phone or another machine reaches it, for pairing links and QR codes (`https://hub.example`). Unset: built from the address the system used to reach the hub.
# HARNESS_PUBLIC_URL=

# The largest package zip or data export the hub unpacks, in bytes (unpacked).
HARNESS_PACKAGE_MAX=200000000

# The npm the hub installs packages and their native externals with.
HARNESS_NPM=npm.cmd

# npm run dev: a comma list of what to run (web, the build; hub; fs; embedder; web-system, which runs only with TAVILY_API_KEY).
HARNESS_DEV_ONLY=web,hub,fs,embedder,web-system

# npm run dev: the folder the fs system serves; this repository when not given.
# HARNESS_DEV_ROOT=

# npm run dev: the EmbeddingGemma service the embedder system wraps.
HARNESS_EMBEDDER_URL=http://127.0.0.1:8760

# npm run dev: the Tavily key the web system searches with; without it the web system is not started.
# TAVILY_API_KEY=
