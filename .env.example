# Copy to .env (git-ignored) and fill in. `npm run dev` and the hub read it; values already in the environment win.

# The single admin account. Made on the first start; signing in uses these.
HARNESS_ADMIN_EMAIL=admin@harness.local
HARNESS_ADMIN_PASSWORD=change-me-please

# Where the hub listens (and serves the web app), and where it keeps its data.
HARNESS_PORT=4300
HARNESS_DATA=.harness

# Models: an OpenRouter key, and the model the chat agent uses until an admin picks one.
# OPENROUTER_API_KEY=sk-or-...
HARNESS_DEFAULT_MODEL=nvidia/nemotron-3.5-super-vl:free

# The folder the fs system serves (default: this repository), and the EmbeddingGemma service.
# HARNESS_DEV_ROOT=C:/path/to/a/folder
HARNESS_EMBEDDER_URL=http://127.0.0.1:8760
