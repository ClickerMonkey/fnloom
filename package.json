{
  "name": "harness",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A web-based agent harness: one hub that owns every LLM call, and systems that connect over WebSocket to add fns, types and resources.",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/core",
    "packages/sdk",
    "packages/hub",
    "packages/cli",
    "packages/build",
    "packages/web",
    "systems/fs",
    "systems/embedder",
    "systems/web",
    "systems/template",
    "systems/input",
    "systems/google-calendar",
    "systems/database",
    "systems/widgets",
    "systems/mcp",
    "systems/code",
    "systems/api",
    "systems/claude"
  ],
  "scripts": {
    "typecheck": "vue-tsc -b",
    "test": "vitest run --project unit --project web",
    "test:watch": "vitest --project unit --project web",
    "test:live": "vitest run --project live",
    "coverage": "vitest run --project unit --project web --coverage",
    "lint": "tsx scripts/lint.ts",
    "web:manifest": "tsx scripts/web-manifest.ts",
    "env:example": "tsx scripts/env-example.ts",
    "docs:authoring": "tsx scripts/docs/authoring.ts",
    "build": "npm run web:manifest && vue-tsc -b && npm run build -w @harness/web",
    "dev": "tsx scripts/dev.ts",
    "live": "tsx scripts/live.ts",
    "e2e": "vitest run --project e2e",
    "check": "tsx scripts/web-manifest.ts --check && tsx scripts/env-example.ts --check && tsx scripts/docs/authoring.ts --check && vue-tsc -b && tsx scripts/lint.ts && npm run coverage && npm run explorer",
    "check:full": "npm run check && npm run test:live && npm run e2e",
    "explorer": "node --experimental-strip-types --no-warnings explorer/build.ts",
    "explorer:serve": "node --experimental-strip-types --no-warnings explorer/serve.ts",
    "context:sync": "ayepi-context docs/ayepi --prune",
    "dev:web": "npm run dev -w @harness/web",
    "e2e:mock": "npm run e2e:mock -w @harness/web",
    "ui-tests": "tsx ui-tests/run.ts",
    "ui-tests:mock": "tsx ui-tests/mock.ts",
    "gallery": "tsx scripts/gallery.ts"
  },
  "devDependencies": {
    "@ayepi/context": "file:../ayepi/packages/context",
    "@ayepi/mock": "file:../ayepi/packages/mock",
    "@ayepi/stress": "file:../ayepi/packages/stress",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "puppeteer": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@ayepi/env": "file:../ayepi/packages/env",
    "zod": "^4.6.7"
  }
}
