{
  "name": "harness",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A web-based agent harness: one hub that owns every LLM call, and stations that connect over WebSocket to add fns, types and resources.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "explorer": "node --experimental-strip-types --no-warnings explorer/build.ts",
    "check": "npm run typecheck && npm run explorer"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aeye/ai": "^0.4.0",
    "@aeye/core": "^0.6.0",
    "@aeye/gin": "^0.4.5",
    "@aeye/models": "^0.4.0",
    "@aeye/resources": "^0.3.9",
    "@ayepi/auth": "^0.4.1",
    "@ayepi/codec": "^0.4.1",
    "@ayepi/core": "^0.4.1",
    "@ayepi/env": "^0.4.1",
    "@ayepi/files": "^0.4.1",
    "@ayepi/log": "^0.4.1",
    "@ayepi/mcp": "^0.4.1",
    "@ayepi/plugin": "^0.4.1",
    "@ayepi/rate": "^0.4.1",
    "@ayepi/work": "^0.4.1",
    "zod": "^4.6.7"
  }
}
