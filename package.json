{
  "name": "harness",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A web-based agent harness: one hub that owns every LLM call, and stations that connect over WebSocket to add fns, types and resources.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "explorer": "node --experimental-strip-types --no-warnings explorer/build.ts",
    "check": "npm run typecheck && npm run explorer"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aeye/core": "file:../aits/packages/core",
    "@aeye/ai": "file:../aits/packages/ai",
    "@aeye/gin": "file:../aits/packages/gin",
    "@aeye/models": "file:../aits/packages/models",
    "@aeye/resources": "file:../aits/packages/resources",
    "@ayepi/auth": "file:../ayepi/packages/auth",
    "@ayepi/codec": "file:../ayepi/packages/codec",
    "@ayepi/core": "file:../ayepi/packages/core",
    "@ayepi/env": "file:../ayepi/packages/env",
    "@ayepi/files": "file:../ayepi/packages/files",
    "@ayepi/log": "file:../ayepi/packages/log",
    "@ayepi/mcp": "file:../ayepi/packages/mcp",
    "@ayepi/plugin": "file:../ayepi/packages/plugin",
    "@ayepi/rate": "file:../ayepi/packages/rate",
    "@ayepi/work": "file:../ayepi/packages/work",
    "zod": "^4.6.7",
    "vue": "^3.5.0"
  }
}
